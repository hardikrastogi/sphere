generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model User {

  
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  bio          String?
  avatarUrl    String?
  posts Post[]
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  likes Like[]
  comments Comment[]
  stories     Story[]
  storyViews  StoryView[]
  followers   Follow[]    @relation("UserFollowers")
  following   Follow[]    @relation("UserFollowing")
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
  conversationsAsUser1  Conversation[] @relation("ConversationUser1")
  conversationsAsUser2  Conversation[] @relation("ConversationUser2")
  messagesSent          Message[]
  callsMade             Call[]         @relation("CallCaller")
  callsReceived         Call[]         @relation("CallCallee")
  isPrivate             Boolean        @default(false)
  showActivityStatus    Boolean        @default(true)

}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, status])
  @@index([followerId, status])
}
enum MediaType {
  PHOTO
  VIDEO
}

model Post {
  id        String      @id @default(cuid())
  caption   String?
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  media     PostMedia[]
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  likes Like[]
  comments Comment[]
  notifications Notification[]
  sharedInMessages Message[]

  @@index([createdAt, id])
}

model PostMedia {
  id       String    @id @default(cuid())
  postId   String
  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  url      String
  publicId String
  type     MediaType
  order    Int       @default(0)

}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, postId])
}
model Comment {
  id        String   @id @default(cuid())
  text      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model Story {
  id        String      @id @default(cuid())
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  url       String
  publicId  String
  type      MediaType
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt DateTime    @db.Timestamptz(3)
  views     StoryView[]
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId String
  viewer   User     @relation(fields: [viewerId], references: [id])
  viewedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([storyId, viewerId])
}

enum NotificationType {
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  LIKE
  COMMENT
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type        NotificationType
  postId      String?
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([recipientId, createdAt, id])
  @@index([recipientId, read])
}

model Conversation {
  id        String    @id @default(cuid())
  user1Id   String
  user2Id   String
  user1     User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text           String
  sharedPostId   String?
  sharedPost     Post?        @relation(fields: [sharedPostId], references: [id], onDelete: SetNull)
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([conversationId, createdAt, id])
  @@index([conversationId, read])
}

enum CallType {
  VIDEO
  AUDIO
}

enum CallStatus {
  COMPLETED
  REJECTED
  MISSED
}

model Call {
  id        String     @id @default(cuid())
  callerId  String
  caller    User       @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId  String
  callee    User       @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  type      CallType
  status    CallStatus
  startedAt DateTime   @default(now()) @db.Timestamptz(3)
  endedAt   DateTime?  @db.Timestamptz(3)

  @@index([callerId])
  @@index([calleeId])
}
