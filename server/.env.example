# Neon Postgres connection string (used by Prisma Client at runtime)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Neon Postgres connection string for Prisma's shadow database (used by `prisma migrate dev` locally only)
SHADOW_DATABASE_URL="postgresql://user:password@host/dbname_shadow?sslmode=require&channel_binding=require"

# Upstash Redis connection string
REDIS_URL="rediss://default:password@host:6379"

# Any long random string - signs JWT auth tokens
JWT_SECRET="replace-with-a-long-random-string"

# Google OAuth credentials (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the authorized redirect URI configured in Google Cloud Console.
# Local dev: http://localhost:4000/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The deployed frontend's URL - used for CORS and the post-Google-login redirect.
# Local dev: http://localhost:3000
CLIENT_URL="http://localhost:3000"

# Set to "production" on the deployed backend (Render sets this automatically on most
# plans, but confirm it in your service's environment settings). Controls auth-cookie
# SameSite/Secure attributes, which must differ between local http and deployed https.
NODE_ENV=development
